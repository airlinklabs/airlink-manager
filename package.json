{
  "name": "airlink-manager",
  "version": "0.1.465",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts --daemon",
    "dev:frontend": "cd frontend && bun run dev",
    "dev:all": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit && cd frontend && tsc --noEmit",
    "test": "bun test --coverage",
    "lint": "bunx @biomejs/biome check src/ frontend/src/",
    "format": "bunx @biomejs/biome format --write src/ frontend/src/"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-switch": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@tanstack/react-query": "^5.75.1",
    "@vitejs/plugin-react": "^4.4.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockerode": "^4.0.2",
    "framer-motion": "^12.9.4",
    "hono": "^4.12.14",
    "lucide-react": "^0.511.0",
    "node-pty": "^1.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8",
    "vite": "^6.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
